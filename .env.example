# ==========================================
# 1. إعدادات Supabase (قاعدة البيانات، المصادقة، التخزين، Realtime)
# ==========================================
# رابط مشروع Supabase الخاص بك (من إعدادات API في لوحة Supabase)
SUPABASE_URL=https://your-project-id.supabase.co
# المفتاح العام Anon للسيرفر
SUPABASE_ANON_KEY=your-supabase-anon-key
# مفتاح الخدمة الإداري السري للسيرفر (لتجاوز RLS في لوحة الإدارة وعمليات الحذف)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# المتغيرات الخاصة بالواجهة الأمامية في المتصفح (Vite Client)
# يجب أن تتطابق مع SUPABASE_URL و SUPABASE_ANON_KEY أعلاه
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ==========================================
# 2. إعدادات بوت وتطبيق Telegram Mini App
# ==========================================
# التوكن المستخرج من @BotFather لبوت تيليجرام
TELEGRAM_BOT_TOKEN=

# ==========================================
# 3. إعدادات مديري لوحة التحكم وحمايتها (Admin Panel)
# ==========================================
# البريد الإلكتروني للمدير الأول المسموح له بظهور زر لوحة التحكم
ADMIN1=lasmr.ok9900@gmail.com
# البريد الإلكتروني للمدير الثاني المسموح له بظهور زر لوحة التحكم
ADMIN2=admin@soulx.app
# رمز PIN السري (مكون من 4 أرقام) لحماية فتح لوحة الإدارة ومسارات الـ API
ADMIN_PIN=2026

# ==========================================
# 4. إعدادات الخادم والشبكة (Server Port)
# ==========================================
PORT=3000